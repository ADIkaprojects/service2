# ─────────────────────────────────────────────────────────────────────────────
# SIGNAL Platform — Environment Variables (local development)
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Infrastructure ────────────────────────────────────────────────────────────
MONGODB_URI=
REDIS_URL=

# ── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Public ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── IP Enrichment ─────────────────────────────────────────────────────────────
IPAPI_IS_KEY=

# ── Identity & Company (Apollo.io) ───────────────────────────────────────────
APOLLO_API_KEY=

# ── Email Discovery & Verification (Hunter.io) ───────────────────────────────
HUNTER_API_KEY=

# ── Email Discovery (Snov.io) ────────────────────────────────────────────────
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=

# ── Web Search ───────────────────────────────────────────────────────────────
SERPER_API_KEY=
TAVILY_API_KEY=

# ── LLM (Mistral) ────────────────────────────────────────────────────────────
MISTRAL_API_KEY=

# ── Email Verification (Verifalia) ───────────────────────────────────────────
VERIFALIA_USERNAME=
VERIFALIA_PASSWORD=

# ── Pipeline Tuning (optional — defaults shown) ──────────────────────────────
# PIPELINE_RATE_LIMIT_WINDOW_SECONDS=300
# PIPELINE_MAX_SESSIONS_PER_IP=1
# CONSENT_TEXT_VERSION=v1.0
# VERIFIED_EMAIL_MIN_CONFIDENCE=0.75
# CATCH_ALL_MIN_CONFIDENCE=0.55
# MISTRAL_CANDIDATE_COUNT=50

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
